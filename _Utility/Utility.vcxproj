<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{B7B60918-2EC7-4B11-98E6-15EE459965E1}</ProjectGuid>
    <RootNamespace>Utility</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(AllegianceRoot)msbuild\Allegiance.Cpp.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir);$(AllegianceRoot)WinTrek;$(MsQuicDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Utility.cpp" />
    <ClCompile Include="KDroot.cpp" />
    <ClCompile Include="KDnode.cpp" />
    <ClCompile Include="HitTest.cpp" />
    <ClCompile Include="CRC.cpp" />
    <ClCompile Include="CollisionEntry.cpp" />
    <ClCompile Include="CollisionQueue.cpp" />
    <ClCompile Include="Messages.cpp" />
    <ClCompile Include="fedtransport.cpp">
      <!-- msquic.h needs Winsock 2 ahead of windows.h, which the PCH can't give it -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Endpoint.cpp" />
    <ClCompile Include="allegdb.cpp" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="CRC.h" />
    <ClInclude Include="fedtransport.h" />
    <ClInclude Include="Utility.h" />
    <ClInclude Include="Utility.hxx" />
    <ClInclude Include="listwrappers.h" />
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\zlib\ZLib.vcxproj">
      <Project>{34F19E78-C3AD-4EEC-8F42-C823D58200C8}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    MsQuic comes from NuGet (packages.config). Visual Studio restores it on build; from the command line:
      msbuild _Utility\Utility.vcxproj -t:restore -p:RestorePackagesConfig=true -p:SolutionDir=<repo>\
    The package's own .targets would link msquic.lib; FedTransport loads msquic.dll at run time
    instead, so only the headers are used here, and the DLL is copied next to the exes (all projects
    share $(OutDir)).
  -->
  <Target Name="AllegianceMsQuicCheck" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(MsQuicDir)include\msquic.h')" Text="MsQuic $(MsQuicVersion) is not restored ($(MsQuicDir)). Restore NuGet packages (Visual Studio does this on build; see _Utility\Utility.vcxproj)." />
  </Target>
  <Target Name="AllegianceMsQuicCopy" AfterTargets="Build">
    <Copy SourceFiles="$(MsQuicDir)bin\x86\msquic.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(Platform)' == 'Win32'" />
    <Copy SourceFiles="$(MsQuicDir)bin\x64\msquic.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(Platform)' == 'x64'" />
  </Target>
</Project>
