      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <!-- Its own folders, then those of the libraries it may use (the layering) -->
      <AdditionalIncludeDirectories>$(MsQuicDir)include;$(AllegianceRoot)Source\NeuronCore;$(AllegianceRoot)Source\NeuronCore\Base;$(AllegianceRoot)Source\NeuronCore\Utility;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
