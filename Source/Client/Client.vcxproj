<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{BE51DFE7-037B-5AF8-BCB6-C1AA36CF0702}</ProjectGuid>
    <RootNamespace>Client</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <!-- Link $(TargetDir)Artwork to out\Artwork after build (Directory.Build.targets). -->
    <AllegianceLinkArtwork>true</AllegianceLinkArtwork>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <!-- Allegiance.exe, the game client: its entry point and resources; the client is GameApp -->
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(AllegianceRoot)msbuild\Allegiance.Cpp.props" />
  </ImportGroup>
  <PropertyGroup>
    <TargetName>Allegiance</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(AllegianceRoot)Source\Client;$(AllegianceRoot)Source\Client\Resources;$(AllegianceRoot)Source\GameApp;$(AllegianceRoot)Source\GameApp\App;$(AllegianceRoot)Source\GameApp\ClientLib;$(AllegianceRoot)Source\GameApp\Training;$(AllegianceRoot)Source\GameCommon;$(AllegianceRoot)Source\GameCommon\Igc;$(AllegianceRoot)Source\GameCommon\Protocol;$(AllegianceRoot)Source\GameCommon\Version;$(AllegianceRoot)Source\NeuronClient;$(AllegianceRoot)Source\NeuronClient\Engine;$(AllegianceRoot)Source\NeuronClient\Effect;$(AllegianceRoot)Source\NeuronClient\Sound;$(AllegianceRoot)Source\NeuronClient\App;$(AllegianceRoot)Source\NeuronCore;$(AllegianceRoot)Source\NeuronCore\Base;$(AllegianceRoot)Source\NeuronCore\Utility;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Every object of GameApp, as when its sources were the executable's own:
           nothing refers to the application object (g_trekImpl), which registers
           itself, so the linker would otherwise leave it out. -->
      <AdditionalOptions>/WHOLEARCHIVE:"$(OutDir)GameApp.lib" %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(AllegianceRoot)Source\Client;$(AllegianceRoot)Source\Client\Resources;$(AllegianceRoot)Source\GameApp;$(AllegianceRoot)Source\GameApp\App;$(AllegianceRoot)Source\GameApp\ClientLib;$(AllegianceRoot)Source\GameApp\Training;$(AllegianceRoot)Source\GameCommon;$(AllegianceRoot)Source\GameCommon\Igc;$(AllegianceRoot)Source\GameCommon\Protocol;$(AllegianceRoot)Source\GameCommon\Version;$(AllegianceRoot)Source\NeuronClient;$(AllegianceRoot)Source\NeuronClient\Engine;$(AllegianceRoot)Source\NeuronClient\Effect;$(AllegianceRoot)Source\NeuronClient\Sound;$(AllegianceRoot)Source\NeuronClient\App;$(AllegianceRoot)Source\NeuronCore;$(AllegianceRoot)Source\NeuronCore\Base;$(AllegianceRoot)Source\NeuronCore\Utility;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Allegiance.build.rc" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="Resources\trek.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\allegiance.rc" />
    <None Include="Resources\allegiance.rc2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameApp\GameApp.vcxproj">
      <Project>{8A9E1169-30E2-5A72-A528-CB6CC3FAD76C}</Project>
      <!-- linked with /WHOLEARCHIVE instead (see Link) -->
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\NeuronClient\NeuronClient.vcxproj">
      <Project>{17EFB152-F918-5928-8AF1-D28BA863A9A3}</Project>
    </ProjectReference>
    <ProjectReference Include="..\GameCommon\GameCommon.vcxproj">
      <Project>{83B45092-097A-509B-9B38-A76D9F8820DF}</Project>
    </ProjectReference>
    <ProjectReference Include="..\NeuronCore\NeuronCore.vcxproj">
      <Project>{D6BA1D66-6693-54B0-9BA9-788192EE921E}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
