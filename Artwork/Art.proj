<?xml version="1.0" encoding="utf-8"?>
<!--
  Art build: turns the sources in Artwork/256 into the flat directory the client
  and server read. Replaces Artwork/256/makefile, makegeo.mak and the
  Artwork/tools batch/awk/sed chain.

    msbuild Artwork\Art.proj -p:Configuration=Debug

  The tools (mdlc, xmunge, cvh, qhull) must already be built for the same
  configuration; this project does not build C++.

  Inputs are the original manifests, unchanged:
    256\bitmap.txt   bitmaps converted to <name>bmp.mdl
    256\copymdl.txt  text MDL files copied as-is
    256\*.wav *.rtf *.mp4 *.igc *.mml   copied as-is
    redbook\*.wav, tracks.lst          the music, copied to redbook\
    256\fontsource.mdl                  compiled to font.mdl, with the fonts in
                                        $(ArtFontDir) (default bin\, not in git:
                                        Eurostile is not freely licensed) loaded
                                        for mdlc only, so they need not be installed
    256\Models.props    models (converted from makegeo.mak): template MDL +
                        mdlc -optimize, collision hull via xmunge + cvh + qhull

  Each step is incremental (Inputs/Outputs). mdlc runs in -batch mode so a step
  starts the engine once, not once per file.

  Output goes to out\Artwork. The client looks for an "Artwork" directory next to
  its exe, so the build also makes $(ArtLinkDir) (by default
  out\bin\Win32\<Configuration>\Artwork) a directory junction to out\Artwork,
  and the same in out\bin\x64\<Configuration> if there is an x64 build.
  -p:ArtLink=false skips that.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <AllegianceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</AllegianceRoot>
    <ArtSource Condition="'$(ArtSource)' == ''">$(MSBuildThisFileDirectory)256\</ArtSource>
    <ArtToolDir Condition="'$(ArtToolDir)' == ''">$(AllegianceRoot)out\bin\Win32\$(Configuration)\</ArtToolDir>
    <ArtOutDir Condition="'$(ArtOutDir)' == ''">$(AllegianceRoot)out\Artwork\</ArtOutDir>
    <ArtLink Condition="'$(ArtLink)' == ''">true</ArtLink>
    <ArtLinkDir Condition="'$(ArtLinkDir)' == ''">$(ArtToolDir)Artwork</ArtLinkDir>
    <!-- The x64 build's exe directory, linked as well when it exists -->
    <ArtLinkDirX64 Condition="'$(ArtLinkDirX64)' == ''">$(AllegianceRoot)out\bin\x64\$(Configuration)\Artwork</ArtLinkDirX64>
    <ArtIntDir Condition="'$(ArtIntDir)' == ''">$(AllegianceRoot)out\obj\Artwork\</ArtIntDir>
    <ArtFontDir Condition="'$(ArtFontDir)' == ''">$(AllegianceRoot)bin\</ArtFontDir>
    <ArtFontDir>$([MSBuild]::EnsureTrailingSlash('$(ArtFontDir)'))</ArtFontDir>
    <ArtTemplateDir Condition="'$(ArtTemplateDir)' == ''">$(MSBuildThisFileDirectory)tools\</ArtTemplateDir>
    <ArtModelDir>$(ArtIntDir)models\</ArtModelDir>
    <Mdlc>$(ArtToolDir)mdlc.exe</Mdlc>
    <Xmunge>$(ArtToolDir)xmunge.exe</Xmunge>
    <Cvh>$(ArtToolDir)cvh.exe</Cvh>
    <Qhull>$(ArtToolDir)qhull.exe</Qhull>
  </PropertyGroup>

  <Import Project="$(ArtSource)Models.props" />

  <!-- Manifests -->

  <Target Name="ReadManifests">
    <ReadLinesFromFile File="$(ArtSource)bitmap.txt">
      <Output TaskParameter="Lines" ItemName="_BitmapName" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(ArtSource)copymdl.txt">
      <Output TaskParameter="Lines" ItemName="_CopyMdlName" />
    </ReadLinesFromFile>

    <ItemGroup>
      <ArtBitmap Include="@(_BitmapName->'$(ArtSource)%(Identity).bmp')" Condition="'%(Identity)' != ''" />
      <ArtCopy Include="@(_CopyMdlName->'$(ArtSource)%(Identity).mdl')" Condition="'%(Identity)' != ''" />
      <ArtCopy Include="$(ArtSource)*.wav;$(ArtSource)*.rtf;$(ArtSource)*.mp4;$(ArtSource)*.igc;$(ArtSource)*.mml" />

      <!-- Animation strips: frames across, frames down (from Artwork/256/makefile). -->
      <ArtAnimation Include="animlaunch"  X="4" Y="4" />
      <ArtAnimation Include="animloadout" X="4" Y="4" />
      <ArtAnimation Include="animinvest"  X="4" Y="4" />
      <ArtAnimation Include="animradar"   X="4" Y="4" />
      <ArtAnimation Include="animsector"  X="2" Y="4" />
      <ArtAnimation Include="animteam"    X="1" Y="3" />
      <_ArtAnimationSource Include="@(ArtAnimation->'$(ArtOutDir)%(Identity)bmp.mdl')" />
    </ItemGroup>

    <!-- Optional per-model sources, as makemdl.bat looked for them -->
    <ItemGroup>
      <ArtModel>
        <Source>$(ArtSource)%(Identity).x</Source>
        <Static Condition="Exists('$(ArtSource)%(Identity)_static.x')">$(ArtSource)%(Identity)_static.x</Static>
        <Static Condition="!Exists('$(ArtSource)%(Identity)_static.x')">$(ArtSource)%(Identity).x</Static>
        <Low Condition="Exists('$(ArtSource)%(Identity)-low.x')">$(ArtSource)%(Identity)-low.x</Low>
        <Bound Condition="Exists('$(ArtSource)%(Identity)_bound.x')">$(ArtSource)%(Identity)_bound.x</Bound>
      </ArtModel>
    </ItemGroup>

    <ItemGroup>
      <_TextModelXName Include="%(ArtTextModel.XFiles)" />
      <_TextModelX Include="@(_TextModelXName->'$(ArtSource)%(Identity)')" />
    </ItemGroup>

    <Error Condition="!Exists('%(_TextModelX.FullPath)')" Text="Models.props: a text model imports %(_TextModelX.Filename)%(_TextModelX.Extension), which does not exist." />
    <Error Condition="!Exists('%(ArtModel.Source)')" Text="Models.props lists %(ArtModel.Identity), but %(ArtModel.Source) does not exist." />
    <Error Condition="'%(ArtModel.Template)' == 'templatelow' and '%(ArtModel.Low)' == ''" Text="%(ArtModel.Identity) uses templatelow, but $(ArtSource)%(ArtModel.Identity)-low.x does not exist." />
    <Error Condition="!Exists('%(ArtBitmap.FullPath)')" Text="bitmap.txt names %(ArtBitmap.Filename), but %(ArtBitmap.FullPath) does not exist." />
    <Error Condition="!Exists('%(ArtCopy.FullPath)')" Text="copymdl.txt names %(ArtCopy.Filename), but %(ArtCopy.FullPath) does not exist." />
  </Target>

  <ItemGroup>
    <_ArtTool Include="$(Mdlc);$(Xmunge);$(Cvh);$(Qhull)" />
  </ItemGroup>

  <Target Name="CheckTools">
    <Error Condition="!Exists('%(_ArtTool.Identity)')" Text="%(_ArtTool.Identity) not found. Build the art tools ($(Configuration)|Win32) first, or set ArtToolDir." />
    <MakeDir Directories="$(ArtOutDir);$(ArtIntDir);$(ArtModelDir)" />
  </Target>

  <!-- 24-bit BMP to 16-bit image MDL -->

  <Target Name="Bitmaps"
          DependsOnTargets="ReadManifests;CheckTools"
          Inputs="@(ArtBitmap);$(Mdlc)"
          Outputs="@(ArtBitmap->'$(ArtOutDir)%(Filename)bmp.mdl')">
    <WriteLinesToFile File="$(ArtIntDir)bitmaps.batch"
                      Lines="@(ArtBitmap->'-convert &quot;%(FullPath)&quot; &quot;$(ArtOutDir)%(Filename)bmp.mdl&quot;')"
                      Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)bitmaps.batch&quot;" WorkingDirectory="$(ArtSource)" />
  </Target>

  <!-- Bitmap strips to frame-animation MDL; reads the converted <name>bmp.mdl -->

  <Target Name="Animations"
          DependsOnTargets="Bitmaps"
          Inputs="@(_ArtAnimationSource);$(Mdlc)"
          Outputs="@(ArtAnimation->'$(ArtOutDir)%(Identity).mdl')">
    <WriteLinesToFile File="$(ArtIntDir)animations.batch"
                      Lines="@(ArtAnimation->'-compressanim %(X) %(Y) %(Identity)bmp &quot;$(ArtOutDir)%(Identity).mdl&quot;')"
                      Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)animations.batch&quot;" WorkingDirectory="$(ArtOutDir)" />
  </Target>

  <!-- Font -->

  <ItemGroup>
    <ArtFont Include="$(ArtFontDir)*.ttf;$(ArtFontDir)*.otf;$(ArtFontDir)*.fon" />
  </ItemGroup>

  <Target Name="Fonts"
          DependsOnTargets="CheckTools"
          Inputs="$(ArtSource)fontsource.mdl;$(Mdlc);@(ArtFont)"
          Outputs="$(ArtOutDir)font.mdl">
    <PropertyGroup>
      <_ArtFontArg Condition="'@(ArtFont)' != ''">-fontdir &quot;$(ArtFontDir.TrimEnd('\'))&quot;</_ArtFontArg>
    </PropertyGroup>
    <Warning Condition="'@(ArtFont)' == ''"
             Text="No fonts in $(ArtFontDir). font.mdl gets whatever Windows substitutes for fonts that are not installed (Eurostile). Set ArtFontDir to a folder with eurosti.ttf and eurostib.ttf." />
    <Exec Command="&quot;$(Mdlc)&quot; $(_ArtFontArg) fontsource &quot;$(ArtOutDir)font.mdl&quot;" WorkingDirectory="$(ArtSource)" />
  </Target>

  <!--
    Models, step 1 (per model, in $(ArtModelDir)), as makemdl.bat / makemdlnone.bat:
      xmunge -flatten   pose the static mesh at Frame        -> <name>flat.x
      xmunge -extract   weapon/cockpit/launch points         -> <name>.dat
      xmunge -bound     "*bound*" pieces of <name>_bound.x   -> <name>_<n>.mesh
      cvh               hull(s) via qhull + the points       -> <name>.cvh
    and the template with "name" and "initialFrame" filled in -> <name>source.mdl.
    The template refers to the .x files by absolute path, so mdlc can run in
    $(ArtOutDir), where it finds the converted textures, while the
    intermediates stay out of it.
  -->

  <Target Name="PrepareModels"
          DependsOnTargets="ReadManifests;CheckTools"
          Inputs="%(ArtModel.Source);%(ArtModel.Static);%(ArtModel.Low);%(ArtModel.Bound);$(ArtTemplateDir)%(ArtModel.Template).mdl;$(Xmunge);$(Cvh);$(Qhull)"
          Outputs="$(ArtModelDir)%(ArtModel.Identity)source.mdl;$(ArtOutDir)%(ArtModel.Identity).cvh">
    <PropertyGroup>
      <_Name>%(ArtModel.Identity)</_Name>
      <_None>false</_None>
      <_None Condition="'%(ArtModel.Template)' == 'templatenone'">true</_None>
      <_Bound>false</_Bound>
      <_Bound Condition="'%(ArtModel.Bound)' != ''">true</_Bound>
      <_Template>$([System.IO.File]::ReadAllText('$(ArtTemplateDir)%(ArtModel.Template).mdl'))</_Template>
      <_Template>$(_Template.Replace('name', '$(ArtModelDir.Replace('\', '\\'))$(_Name)').Replace('initialFrame', '%(ArtModel.Frame)'))</_Template>
    </PropertyGroup>
    <ItemGroup>
      <_StaleMesh Include="$(ArtModelDir)$(_Name)_*.mesh" />
    </ItemGroup>

    <Delete Files="@(_StaleMesh);$(ArtModelDir)$(_Name).dat" />
    <Copy SourceFiles="%(ArtModel.Source)" DestinationFiles="$(ArtModelDir)$(_Name).x" />
    <Copy SourceFiles="%(ArtModel.Static)" DestinationFiles="$(ArtModelDir)$(_Name)_static.x" Condition="!$(_None)" />
    <Copy SourceFiles="%(ArtModel.Low)" DestinationFiles="$(ArtModelDir)$(_Name)-low.x" Condition="'%(ArtModel.Low)' != ''" />
    <Copy SourceFiles="%(ArtModel.Bound)" DestinationFiles="$(ArtModelDir)$(_Name)_bound.x" Condition="$(_Bound)" />

    <Exec Condition="$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -flatten %(ArtModel.Frame) $(_Name).x $(_Name)flat.x" />
    <Exec Condition="$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -flatten $(_Name)" />

    <Exec Condition="!$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -flatten %(ArtModel.Frame) $(_Name)_static.x $(_Name)flat.x" />
    <Exec Condition="!$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -extract %(ArtModel.Frame) $(_Name).x $(_Name)" />
    <Exec Condition="!$(_None) and $(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -bound %(ArtModel.Frame) $(_Name)_bound.x $(_Name)" />
    <Exec Condition="!$(_None) and $(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -bound $(_Name)" />
    <Exec Condition="!$(_None) and !$(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -extract $(_Name)" />

    <Copy SourceFiles="$(ArtModelDir)$(_Name).cvh" DestinationFolder="$(ArtOutDir)" />
    <WriteLinesToFile File="$(ArtModelDir)$(_Name)source.mdl" Lines="$([MSBuild]::Escape($(_Template)))" Overwrite="true" />
  </Target>

  <!-- Models, step 2: mdlc -optimize for all models in one process, in $(ArtOutDir) -->

  <Target Name="Models"
          DependsOnTargets="Bitmaps;PrepareModels"
          Inputs="@(ArtModel->'$(ArtModelDir)%(Identity)source.mdl');$(Mdlc)"
          Outputs="@(ArtModel->'$(ArtOutDir)%(Identity).mdl')">
    <WriteLinesToFile File="$(ArtIntDir)models.batch"
                      Lines="@(ArtModel->'-optimize &quot;$(ArtModelDir)%(Identity)source&quot; %(Identity)')"
                      Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)models.batch&quot;" WorkingDirectory="$(ArtOutDir)" />
  </Target>

  <!--
    Models from hand-written text MDLs (Models.props ArtTextModel). As in
    makegeo.mak, the .x files they import are copied next to them in
    $(ArtOutDir), and mdlc runs there.
  -->

  <Target Name="TextModels"
          DependsOnTargets="ReadManifests;Bitmaps;Copies"
          Inputs="@(ArtTextModel->'$(ArtSource)%(Text).mdl');@(_TextModelX);$(Mdlc)"
          Outputs="@(ArtTextModel->'$(ArtOutDir)%(Identity).mdl')">
    <ItemGroup>
      <_TextModelLine Include="-optimize %(ArtTextModel.Text) %(ArtTextModel.Identity)" Condition="'%(ArtTextModel.Mode)' == 'optimize'" />
      <_TextModelLine Include="%(ArtTextModel.Text) %(ArtTextModel.Identity).mdl" Condition="'%(ArtTextModel.Mode)' == 'compile'" />
    </ItemGroup>
    <Copy SourceFiles="@(_TextModelX)" DestinationFolder="$(ArtOutDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(ArtIntDir)textmodels.batch" Lines="@(_TextModelLine)" Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)textmodels.batch&quot;" WorkingDirectory="$(ArtOutDir)" />
  </Target>

  <!-- Files used as-is -->

  <Target Name="Copies" DependsOnTargets="ReadManifests;CheckTools">
    <Copy SourceFiles="@(ArtCopy)" DestinationFolder="$(ArtOutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The soundtrack: redbook\*.wav and tracks.lst, played by the client's music
    player (they were the Audio CD's tracks). Hard links where the volume
    allows, since the WAVs are about 260 MB. A checkout without them (CI's art
    job) copies nothing: both are wildcards, because an item with a plain path
    is kept, and copied, even when the file does not exist.
  -->
  <ItemGroup>
    <ArtMusic Include="$(MSBuildThisFileDirectory)redbook\*.wav;$(MSBuildThisFileDirectory)redbook\*.lst" />
  </ItemGroup>

  <Target Name="Music">
    <Copy SourceFiles="@(ArtMusic)" DestinationFolder="$(ArtOutDir)redbook" SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />
  </Target>

  <!--
    Point the exe directory's Artwork at $(ArtOutDir) with a directory junction
    (no admin rights needed). rmdir without /s removes only a junction or an empty
    directory, such as the one the client creates when it finds no art; a real
    directory with files in it is left alone and reported.
  -->

  <PropertyGroup>
    <_ArtLinkEnabled>false</_ArtLinkEnabled>
    <_ArtLinkEnabled Condition="'$(ArtLink)' == 'true' and '$([MSBuild]::NormalizeDirectory($(ArtLinkDir)))' != '$([MSBuild]::NormalizeDirectory($(ArtOutDir)))'">true</_ArtLinkEnabled>
    <_ArtLinkX64Enabled>false</_ArtLinkX64Enabled>
    <_ArtLinkX64Enabled Condition="'$(ArtLink)' == 'true' and Exists('$([System.IO.Path]::GetDirectoryName($(ArtLinkDirX64)))') and '$([MSBuild]::NormalizeDirectory($(ArtLinkDirX64)))' != '$([MSBuild]::NormalizeDirectory($(ArtLinkDir)))'">true</_ArtLinkX64Enabled>
  </PropertyGroup>

  <Target Name="LinkArtwork" DependsOnTargets="CheckTools" Condition="$(_ArtLinkEnabled)">
    <Exec Command="(rmdir &quot;$(ArtLinkDir)&quot; 2&gt;nul &amp; mklink /J &quot;$(ArtLinkDir)&quot; &quot;$(ArtOutDir.TrimEnd('\'))&quot; &gt;nul) || (echo Art.proj : error : could not link $(ArtLinkDir) to $(ArtOutDir). If it is a directory with files in it, move or delete it, or build with -p:ArtLink=false. &amp; exit /b 1)" />
    <Message Importance="high" Text="Artwork: $(ArtLinkDir) -> $(ArtOutDir)" />
  </Target>

  <Target Name="LinkArtworkX64" DependsOnTargets="CheckTools" Condition="$(_ArtLinkX64Enabled)">
    <Exec Command="(rmdir &quot;$(ArtLinkDirX64)&quot; 2&gt;nul &amp; mklink /J &quot;$(ArtLinkDirX64)&quot; &quot;$(ArtOutDir.TrimEnd('\'))&quot; &gt;nul) || (echo Art.proj : error : could not link $(ArtLinkDirX64) to $(ArtOutDir). If it is a directory with files in it, move or delete it, or build with -p:ArtLink=false. &amp; exit /b 1)" />
    <Message Importance="high" Text="Artwork: $(ArtLinkDirX64) -> $(ArtOutDir)" />
  </Target>

  <Target Name="Build" DependsOnTargets="Copies;Music;Bitmaps;Animations;Fonts;Models;TextModels;LinkArtwork;LinkArtworkX64" />

  <Target Name="Clean">
    <!-- Remove the junction itself first, so nothing follows it into $(ArtOutDir). -->
    <Exec Condition="$(_ArtLinkEnabled) and Exists('$(ArtLinkDir)')" Command="rmdir &quot;$(ArtLinkDir)&quot;" ContinueOnError="true" />
    <Exec Condition="$(_ArtLinkX64Enabled) and Exists('$(ArtLinkDirX64)')" Command="rmdir &quot;$(ArtLinkDirX64)&quot;" ContinueOnError="true" />
    <RemoveDir Directories="$(ArtOutDir);$(ArtIntDir)" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

</Project>
