<?xml version="1.0" encoding="utf-8"?>
<!--
  Art build: turns the sources in Artwork\<folder> into out\Artwork\<folder>,
  which the client and server read. Replaces the original makefile,
  makegeo.mak and the Artwork/tools batch/awk/sed chain.

    msbuild Artwork\Art.proj -p:Configuration=Debug

  The tools (mdlc, xmunge, cvh, qhull) must already be built for the same
  configuration; this project does not build C++.

  The folders (see MODERNIZATION.md, "Art folders"); each is copied as it is
  unless noted:
    Audio\*.wav       sound effects and voices
    Music\*.wav, tracks.lst   the soundtrack (the original Audio CD's tracks)
    Textures\*.dds    images that are not model textures: UI, HUD, icons,
                      effects, planets, backgrounds (32-bit BGRA, the colour
                      key in alpha; see tools\art\bmp2dds.py). The six
                      animation strips also get a text MDL each, in Interface
    Models\           the models' .x sources and textures (.dds), and the
                      hand-written text models (Models.props). The output gets
                      each model's .mdl (mdlc -optimize) and .cvh (xmunge +
                      cvh + qhull), the textures, and the text models' .x files
    Fonts\fontsource.mdl   compiled to font.mdl, with the fonts in $(ArtFontDir)
                      (default Artwork\Fonts: *.ttf are not in git, since
                      Eurostile is not freely licensed) loaded for mdlc only, so
                      they need not be installed
    Interface\*.mdl *.mml   the UI: screens, panes, cursors, sound definitions;
                      help pages
    Movies\*.mp4      the opening movies
    Data\*.igc       the core files and training maps

  The client and server find a file by its bare name in the folders for its
  type (ModelerImpl::GetFile, UTL::getFile), so nothing names a folder.

  Each step is incremental (Inputs/Outputs). mdlc runs in -batch mode so a step
  starts the engine once, not once per file.

  Output goes to out\Artwork. The client looks for an "Artwork" directory next to
  its exe, so the build also makes $(ArtLinkDir) (by default
  out\bin\x64\<Configuration>\Artwork) a directory junction to out\Artwork.
  -p:ArtLink=false skips that.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <AllegianceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</AllegianceRoot>
    <ArtSource Condition="'$(ArtSource)' == ''">$(MSBuildThisFileDirectory)</ArtSource>
    <ArtSource>$([MSBuild]::EnsureTrailingSlash('$(ArtSource)'))</ArtSource>
    <ArtToolDir Condition="'$(ArtToolDir)' == ''">$(AllegianceRoot)out\bin\x64\$(Configuration)\</ArtToolDir>
    <ArtOutDir Condition="'$(ArtOutDir)' == ''">$(AllegianceRoot)out\Artwork\</ArtOutDir>
    <ArtLink Condition="'$(ArtLink)' == ''">true</ArtLink>
    <ArtLinkDir Condition="'$(ArtLinkDir)' == ''">$(ArtToolDir)Artwork</ArtLinkDir>
    <ArtIntDir Condition="'$(ArtIntDir)' == ''">$(AllegianceRoot)out\obj\Artwork\</ArtIntDir>
    <ArtFontDir Condition="'$(ArtFontDir)' == ''">$(ArtSource)Fonts\</ArtFontDir>
    <ArtFontDir>$([MSBuild]::EnsureTrailingSlash('$(ArtFontDir)'))</ArtFontDir>
    <ArtTemplateDir Condition="'$(ArtTemplateDir)' == ''">$(MSBuildThisFileDirectory)tools\</ArtTemplateDir>
    <ArtModelDir>$(ArtIntDir)models\</ArtModelDir>
    <Mdlc>$(ArtToolDir)mdlc.exe</Mdlc>
    <Xmunge>$(ArtToolDir)xmunge.exe</Xmunge>
    <Cvh>$(ArtToolDir)cvh.exe</Cvh>
    <Qhull>$(ArtToolDir)qhull.exe</Qhull>

    <!-- Source folders -->
    <ArtAudio>$(ArtSource)Audio\</ArtAudio>
    <ArtMusicSource>$(ArtSource)Music\</ArtMusicSource>
    <ArtTextures>$(ArtSource)Textures\</ArtTextures>
    <ArtModels>$(ArtSource)Models\</ArtModels>
    <ArtFonts>$(ArtSource)Fonts\</ArtFonts>
    <ArtInterface>$(ArtSource)Interface\</ArtInterface>
    <ArtMovies>$(ArtSource)Movies\</ArtMovies>
    <ArtData>$(ArtSource)Data\</ArtData>

    <!-- Output folders -->
    <ArtOutAudio>$(ArtOutDir)Audio\</ArtOutAudio>
    <ArtOutMusic>$(ArtOutDir)Music\</ArtOutMusic>
    <ArtOutTextures>$(ArtOutDir)Textures\</ArtOutTextures>
    <ArtOutModels>$(ArtOutDir)Models\</ArtOutModels>
    <ArtOutFonts>$(ArtOutDir)Fonts\</ArtOutFonts>
    <ArtOutInterface>$(ArtOutDir)Interface\</ArtOutInterface>
    <ArtOutMovies>$(ArtOutDir)Movies\</ArtOutMovies>
    <ArtOutData>$(ArtOutDir)Data\</ArtOutData>

    <!-- mdlc -artpath for the model batches (no trailing backslash before the quote;
         a property, since a property function can't go inside an item transform) -->
    <_ArtPathArg>$(ArtOutDir.TrimEnd('\'))</_ArtPathArg>
  </PropertyGroup>

  <Import Project="$(ArtSource)Models.props" />

  <!-- The folders are the manifests -->

  <ItemGroup>
    <ArtTexture Include="$(ArtTextures)*.dds" />
    <ArtModelTexture Include="$(ArtModels)*.dds" />
    <ArtCopy Include="$(ArtAudio)*.wav" Dest="$(ArtOutAudio)" />
    <ArtCopy Include="$(ArtInterface)*.mdl;$(ArtInterface)*.mml" Dest="$(ArtOutInterface)" />
    <ArtCopy Include="$(ArtMovies)*.mp4" Dest="$(ArtOutMovies)" />
    <ArtCopy Include="$(ArtData)*.igc" Dest="$(ArtOutData)" />

    <!-- Animation strips: frames across, frames down (from the original makefile). -->
    <ArtAnimation Include="animlaunch"  X="4" Y="4" />
    <ArtAnimation Include="animloadout" X="4" Y="4" />
    <ArtAnimation Include="animinvest"  X="4" Y="4" />
    <ArtAnimation Include="animradar"   X="4" Y="4" />
    <ArtAnimation Include="animsector"  X="2" Y="4" />
    <ArtAnimation Include="animteam"    X="1" Y="3" />
  </ItemGroup>

  <Target Name="ReadManifests">
    <ItemGroup>
      <_ArtAnimationSource Include="@(ArtAnimation->'$(ArtTextures)%(Identity).dds')" />
    </ItemGroup>

    <!-- Optional per-model sources, as makemdl.bat looked for them -->
    <ItemGroup>
      <ArtModel>
        <Source>$(ArtModels)%(Identity).x</Source>
        <Static Condition="Exists('$(ArtModels)%(Identity)_static.x')">$(ArtModels)%(Identity)_static.x</Static>
        <Static Condition="!Exists('$(ArtModels)%(Identity)_static.x')">$(ArtModels)%(Identity).x</Static>
        <Low Condition="Exists('$(ArtModels)%(Identity)-low.x')">$(ArtModels)%(Identity)-low.x</Low>
        <Bound Condition="Exists('$(ArtModels)%(Identity)_bound.x')">$(ArtModels)%(Identity)_bound.x</Bound>
      </ArtModel>
    </ItemGroup>

    <ItemGroup>
      <_TextModelXName Include="%(ArtTextModel.XFiles)" />
      <_TextModelX Include="@(_TextModelXName->'$(ArtModels)%(Identity)')" />
      <_TextModelSource Include="@(ArtTextModel->'$(ArtModels)%(Text).mdl')" />
    </ItemGroup>

    <Error Condition="!Exists('%(_TextModelX.FullPath)')" Text="Models.props: a text model imports %(_TextModelX.Filename)%(_TextModelX.Extension), which is not in $(ArtModels)." />
    <Error Condition="!Exists('%(_TextModelSource.FullPath)')" Text="Models.props: the text model %(_TextModelSource.Filename) is not in $(ArtModels)." />
    <Error Condition="!Exists('%(ArtModel.Source)')" Text="Models.props lists %(ArtModel.Identity), but %(ArtModel.Source) does not exist." />
    <Error Condition="'%(ArtModel.Template)' == 'templatelow' and '%(ArtModel.Low)' == ''" Text="%(ArtModel.Identity) uses templatelow, but $(ArtModels)%(ArtModel.Identity)-low.x does not exist." />
    <Error Condition="!Exists('%(_ArtAnimationSource.FullPath)')" Text="The animation strip %(_ArtAnimationSource.Filename) is not in $(ArtTextures)." />
  </Target>

  <ItemGroup>
    <_ArtTool Include="$(Mdlc);$(Xmunge);$(Cvh);$(Qhull)" />
  </ItemGroup>

  <Target Name="CheckTools">
    <Error Condition="!Exists('%(_ArtTool.Identity)')" Text="%(_ArtTool.Identity) not found. Build the art tools ($(Configuration)|x64) first, or set ArtToolDir." />
    <MakeDir Directories="$(ArtOutDir);$(ArtIntDir);$(ArtModelDir);$(ArtOutAudio);$(ArtOutMusic);$(ArtOutTextures);$(ArtOutModels);$(ArtOutFonts);$(ArtOutInterface);$(ArtOutMovies);$(ArtOutData)" />
  </Target>

  <!--
    Images: the DDS files are the source art (Source/NeuronClient/Engine/dds.h, Tools\art\bmp2dds.py),
    copied as they are: Textures\ to Textures\, the model textures to Models\.
  -->

  <Target Name="Bitmaps"
          DependsOnTargets="ReadManifests;CheckTools"
          Inputs="@(ArtTexture);@(ArtModelTexture)"
          Outputs="@(ArtTexture->'$(ArtOutTextures)%(Filename).dds');@(ArtModelTexture->'$(ArtOutModels)%(Filename).dds')">
    <Copy SourceFiles="@(ArtTexture)" DestinationFolder="$(ArtOutTextures)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ArtModelTexture)" DestinationFolder="$(ArtOutModels)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Animations: a small text MDL per strip, in Interface\, which builds the
    frame animation from the strip's DDS when it is loaded (FrameImage).
    mdlc -compressanim used to precompute it into a binary MDL with 16-bit
    frames.
  -->

  <Target Name="Animations"
          DependsOnTargets="ReadManifests;CheckTools"
          Inputs="@(_ArtAnimationSource)"
          Outputs="@(ArtAnimation->'$(ArtOutInterface)%(Identity).mdl')">
    <WriteLinesToFile File="$(ArtOutInterface)%(ArtAnimation.Identity).mdl"
                      Lines="// Generated by Artwork\Art.proj: %(ArtAnimation.Identity).dds as %(ArtAnimation.X) x %(ArtAnimation.Y) frames;use &quot;model&quot;%3B;frame = ModifiableNumber(0)%3B;image = FrameImage(ImportImage(&quot;%(ArtAnimation.Identity)bmp&quot;, false), frame, %(ArtAnimation.X), %(ArtAnimation.Y))%3B"
                      Overwrite="true" />
  </Target>

  <!-- Font -->

  <ItemGroup>
    <ArtFont Include="$(ArtFontDir)*.ttf;$(ArtFontDir)*.otf;$(ArtFontDir)*.fon" />
  </ItemGroup>

  <Target Name="Fonts"
          DependsOnTargets="CheckTools"
          Inputs="$(ArtFonts)fontsource.mdl;$(Mdlc);@(ArtFont)"
          Outputs="$(ArtOutFonts)font.mdl">
    <PropertyGroup>
      <_ArtFontArg Condition="'@(ArtFont)' != ''">-fontdir &quot;$(ArtFontDir.TrimEnd('\'))&quot;</_ArtFontArg>
    </PropertyGroup>
    <Warning Condition="'@(ArtFont)' == ''"
             Text="No fonts in $(ArtFontDir). font.mdl gets whatever Windows substitutes for fonts that are not installed (Eurostile). Put eurosti.ttf and eurostib.ttf there, or set ArtFontDir to a folder with them." />
    <Exec Command="&quot;$(Mdlc)&quot; $(_ArtFontArg) fontsource &quot;$(ArtOutFonts)font.mdl&quot;" WorkingDirectory="$(ArtFonts)" />
  </Target>

  <!--
    Models, step 1 (per model, in $(ArtModelDir)), as makemdl.bat / makemdlnone.bat:
      xmunge -flatten   pose the static mesh at Frame        -> <name>flat.x
      xmunge -extract   weapon/cockpit/launch points         -> <name>.dat
      xmunge -bound     "*bound*" pieces of <name>_bound.x   -> <name>_<n>.mesh
      cvh               hull(s) via qhull + the points       -> <name>.cvh
    and the template with "name" and "initialFrame" filled in -> <name>source.mdl.
    The template refers to the .x files by absolute path, so mdlc can run in
    $(ArtOutModels), where it finds the textures, while the intermediates stay
    out of it.
  -->

  <Target Name="PrepareModels"
          DependsOnTargets="ReadManifests;CheckTools"
          Inputs="%(ArtModel.Source);%(ArtModel.Static);%(ArtModel.Low);%(ArtModel.Bound);$(ArtTemplateDir)%(ArtModel.Template).mdl;$(Xmunge);$(Cvh);$(Qhull)"
          Outputs="$(ArtModelDir)%(ArtModel.Identity)source.mdl;$(ArtOutModels)%(ArtModel.Identity).cvh">
    <PropertyGroup>
      <_Name>%(ArtModel.Identity)</_Name>
      <_None>false</_None>
      <_None Condition="'%(ArtModel.Template)' == 'templatenone'">true</_None>
      <_Bound>false</_Bound>
      <_Bound Condition="'%(ArtModel.Bound)' != ''">true</_Bound>
      <_Template>$([System.IO.File]::ReadAllText('$(ArtTemplateDir)%(ArtModel.Template).mdl'))</_Template>
      <_Template>$(_Template.Replace('name', '$(ArtModelDir.Replace('\', '\\'))$(_Name)').Replace('initialFrame', '%(ArtModel.Frame)'))</_Template>
    </PropertyGroup>
    <ItemGroup>
      <_StaleMesh Include="$(ArtModelDir)$(_Name)_*.mesh" />
    </ItemGroup>

    <Delete Files="@(_StaleMesh);$(ArtModelDir)$(_Name).dat" />
    <Copy SourceFiles="%(ArtModel.Source)" DestinationFiles="$(ArtModelDir)$(_Name).x" />
    <Copy SourceFiles="%(ArtModel.Static)" DestinationFiles="$(ArtModelDir)$(_Name)_static.x" Condition="!$(_None)" />
    <Copy SourceFiles="%(ArtModel.Low)" DestinationFiles="$(ArtModelDir)$(_Name)-low.x" Condition="'%(ArtModel.Low)' != ''" />
    <Copy SourceFiles="%(ArtModel.Bound)" DestinationFiles="$(ArtModelDir)$(_Name)_bound.x" Condition="$(_Bound)" />

    <Exec Condition="$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -flatten %(ArtModel.Frame) $(_Name).x $(_Name)flat.x" />
    <Exec Condition="$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -flatten $(_Name)" />

    <Exec Condition="!$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -flatten %(ArtModel.Frame) $(_Name)_static.x $(_Name)flat.x" />
    <Exec Condition="!$(_None)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -extract %(ArtModel.Frame) $(_Name).x $(_Name)" />
    <Exec Condition="!$(_None) and $(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Xmunge)&quot; -bound %(ArtModel.Frame) $(_Name)_bound.x $(_Name)" />
    <Exec Condition="!$(_None) and $(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -bound $(_Name)" />
    <Exec Condition="!$(_None) and !$(_Bound)" WorkingDirectory="$(ArtModelDir)" Command="&quot;$(Cvh)&quot; -extract $(_Name)" />

    <Copy SourceFiles="$(ArtModelDir)$(_Name).cvh" DestinationFolder="$(ArtOutModels)" />
    <WriteLinesToFile File="$(ArtModelDir)$(_Name)source.mdl" Lines="$([MSBuild]::Escape($(_Template)))" Overwrite="true" />
  </Target>

  <!--
    Models, step 2: mdlc -optimize for all models in one process, in
    $(ArtOutModels), where the outputs go. -artpath points the lookup at
    $(ArtOutDir), so mdlc finds the models' textures in Models\ and the effect
    images the optimizer adds (the strobe of the lights) in Textures\.
  -->

  <Target Name="Models"
          DependsOnTargets="Bitmaps;PrepareModels"
          Inputs="@(ArtModel->'$(ArtModelDir)%(Identity)source.mdl');$(Mdlc)"
          Outputs="@(ArtModel->'$(ArtOutModels)%(Identity).mdl')">
    <WriteLinesToFile File="$(ArtIntDir)models.batch"
                      Lines="@(ArtModel->'-artpath &quot;$(_ArtPathArg)&quot; -optimize &quot;$(ArtModelDir)%(Identity)source&quot; %(Identity)')"
                      Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)models.batch&quot;" WorkingDirectory="$(ArtOutModels)" />
  </Target>

  <!--
    Models from hand-written text MDLs (Models.props ArtTextModel). As in
    makegeo.mak, the text MDL and the .x files it imports are copied to
    $(ArtOutModels), and mdlc runs there, with -artpath as for the models.
  -->

  <Target Name="TextModels"
          DependsOnTargets="ReadManifests;Bitmaps"
          Inputs="@(_TextModelSource);@(_TextModelX);$(Mdlc)"
          Outputs="@(ArtTextModel->'$(ArtOutModels)%(Identity).mdl')">
    <ItemGroup>
      <_TextModelLine Include="-artpath &quot;$(_ArtPathArg)&quot; -optimize %(ArtTextModel.Text) %(ArtTextModel.Identity)" Condition="'%(ArtTextModel.Mode)' == 'optimize'" />
      <_TextModelLine Include="-artpath &quot;$(_ArtPathArg)&quot; %(ArtTextModel.Text) %(ArtTextModel.Identity).mdl" Condition="'%(ArtTextModel.Mode)' == 'compile'" />
    </ItemGroup>
    <Copy SourceFiles="@(_TextModelSource);@(_TextModelX)" DestinationFolder="$(ArtOutModels)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(ArtIntDir)textmodels.batch" Lines="@(_TextModelLine)" Overwrite="true" />
    <Exec Command="&quot;$(Mdlc)&quot; -batch &quot;$(ArtIntDir)textmodels.batch&quot;" WorkingDirectory="$(ArtOutModels)" />
  </Target>

  <!-- Files used as-is -->

  <Target Name="Copies" DependsOnTargets="CheckTools">
    <Copy SourceFiles="@(ArtCopy)" DestinationFolder="%(ArtCopy.Dest)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The soundtrack: Music\*.wav and tracks.lst, played by the client's music
    player (they were the Audio CD's tracks). Hard links where the volume
    allows, since the WAVs are about 260 MB. A checkout without them (CI's art
    job) copies nothing: both are wildcards, because an item with a plain path
    is kept, and copied, even when the file does not exist.
  -->

  <ItemGroup>
    <ArtMusic Include="$(ArtMusicSource)*.wav;$(ArtMusicSource)*.lst" />
  </ItemGroup>

  <Target Name="Music" DependsOnTargets="CheckTools">
    <Copy SourceFiles="@(ArtMusic)" DestinationFolder="$(ArtOutMusic)" SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />
  </Target>

  <!--
    Point the exe directory's Artwork at $(ArtOutDir) with a directory junction
    (no admin rights needed). rmdir without /s removes only a junction or an empty
    directory, such as the one the client creates when it finds no art; a real
    directory with files in it is left alone and reported.
  -->

  <PropertyGroup>
    <_ArtLinkEnabled>false</_ArtLinkEnabled>
    <_ArtLinkEnabled Condition="'$(ArtLink)' == 'true' and '$([MSBuild]::NormalizeDirectory($(ArtLinkDir)))' != '$([MSBuild]::NormalizeDirectory($(ArtOutDir)))'">true</_ArtLinkEnabled>
  </PropertyGroup>

  <Target Name="LinkArtwork" DependsOnTargets="CheckTools" Condition="$(_ArtLinkEnabled)">
    <Exec Command="(rmdir &quot;$(ArtLinkDir)&quot; 2&gt;nul &amp; mklink /J &quot;$(ArtLinkDir)&quot; &quot;$(ArtOutDir.TrimEnd('\'))&quot; &gt;nul) || (echo Art.proj : error : could not link $(ArtLinkDir) to $(ArtOutDir). If it is a directory with files in it, move or delete it, or build with -p:ArtLink=false. &amp; exit /b 1)" />
    <Message Importance="high" Text="Artwork: $(ArtLinkDir) -> $(ArtOutDir)" />
  </Target>

  <Target Name="Build" DependsOnTargets="Copies;Music;Bitmaps;Animations;Fonts;Models;TextModels;LinkArtwork" />

  <Target Name="Clean">
    <!-- Remove the junction itself first, so nothing follows it into $(ArtOutDir). -->
    <Exec Condition="$(_ArtLinkEnabled) and Exists('$(ArtLinkDir)')" Command="rmdir &quot;$(ArtLinkDir)&quot;" ContinueOnError="true" />
    <RemoveDir Directories="$(ArtOutDir);$(ArtIntDir)" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

</Project>
