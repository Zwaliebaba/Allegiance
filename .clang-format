# C++ layout (AGENTS.md section 4).
#
# clang-format owns WHITESPACE; /.clang-tidy owns NAMING and semantics. The two never overlap.
#
# The values come from the sibling repositories Outpost.Warzone and Nomad-Commander, so that
# code moves between the trees without reflowing.
#
# ── Status: for NEW files, not the tree ────────────────────────────────────────────────────
#
# The tree is NOT formatted to this file, and will not be: most of it is 4-space, with K&R and
# Allman braces mixed, and a whole-tree run would rewrite nearly every line and bury the
# history (an owner decision: no repo-wide reformat). So:
#
#   - a NEW file is written to this file, and may be run through clang-format whole;
#   - in an existing file, match the file: its indent, its braces. Do not run clang-format over
#     it, not even over "your" lines, because a 2-space block in a 4-space function is worse
#     than either.
#
# No CI step runs clang-format. If one is added, it formats new files only.
#
# Results differ between clang-format releases (Visual Studio 2026 bundles a newer one than most
# Linux distributions); if two runs disagree, compare the version line first.
# Keep ColumnLimit and IndentWidth in step with /.editorconfig.
#
# ── Deliberate choices ─────────────────────────────────────────────────────────────────────
#
# LineEnding is left at its default (DeriveLF) ON PURPOSE. Working trees are CRLF on Windows and
# LF in Linux containers, so deriving per file means the same command is a no-op in both places.
#
# AlignConsecutive{Assignments,Declarations} are OFF: clang-format cannot express "align this
# short run but not that one", and switching them on aligns unrelated statements across whole
# blocks.
#
# ReflowComments is OFF so that the block comments explaining a decision keep the line breaks
# their author chose.

Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

ColumnLimit: 140
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 2

# Allman: every brace on its own line.
BreakBeforeBraces: Allman

# A namespace does not indent its contents — the whole file would be one level in for no
# information gained.
NamespaceIndentation: None

# -2, matching IndentWidth: `public:` sits flush with the `class`, its members one step in.
AccessModifierOffset: -2
IndentAccessModifiers: false
IndentCaseLabels: false

IndentPPDirectives: AfterHash
PPIndentWidth: 3

# ID3D11Device* _device, not ID3D11Device *_device.
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Control flow never folds onto one line; an empty body may.
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: All

BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 2
PackConstructorInitializers: Never

# A `requires` clause goes on its own line, indented under the template head — the constraint is
# part of the declaration's contract and reads as such.
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterRequiresInClause: true
  AfterRequiresInExpression: false
RequiresClausePosition: OwnLine
IndentRequiresClause: true

AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignAfterOpenBracket: Align
AlignEscapedNewlines: Left
AlignTrailingComments: true

# Include order is load-bearing and grouped by hand (AGENTS.md section 4): pch.h first (MSVC
# ignores everything above it), then the SDK, then project headers. The pch.h files themselves
# order windows.h, the D3D11/DXGI/XAudio2 headers and the layered library headers on purpose. A
# formatter reordering these behind a change's back is a correctness risk, not a style preference.
SortIncludes: Never
IncludeBlocks: Preserve

BinPackArguments: true
BinPackParameters: true
Cpp11BracedListStyle: true
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SpacesBeforeTrailingComments: 1
ReflowComments: false

# The Visual Studio unit-test macros read as calls, so clang-format collapses a whole TEST_CLASS
# into one line of nonsense. Describing what they expand to lets it format a test file like the
# class and methods it actually is.
Macros:
  - 'TEST_CLASS(x)=class x'
  - 'TEST_METHOD(x)=void x()'
  - 'TEST_CLASS_INITIALIZE(x)=void x()'
  - 'TEST_CLASS_CLEANUP(x)=void x()'
  - 'TEST_METHOD_INITIALIZE(x)=void x()'
  - 'TEST_METHOD_CLEANUP(x)=void x()'
