<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared C++ settings for all Allegiance projects. Imported in each project's
  PropertySheets group, i.e. after Microsoft.Cpp.props, so these override the
  toolset defaults while still letting the project file override them.

  Baseline choices (Phase 1/2 of MODERNIZATION.md):
    - x64 only (Win32 was dropped once x64 had been played). The
      pointer-truncation warnings are errors (see below).
    - Static CRT, matching the original /MT /MTd builds.
    - C++17 with permissive mode; /permissive- is switched on in Phase 2.
    - /EHsc instead of the original /GX-: the modern STL and comdef require it.
-->
<Project>
  <PropertyGroup>
    <OutDir>$(AllegianceRoot)out\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(AllegianceRoot)out\obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <!-- Generated sources shared between projects (MIDL, mc and XSLT output). -->
    <AllegianceGenDir>$(AllegianceRoot)out\gen\$(Platform)\$(Configuration)\</AllegianceGenDir>
    <!-- MsQuic, restored from NuGet into packages\ (_Utility\packages.config; keep the versions equal) -->
    <MsQuicVersion>2.6.4</MsQuicVersion>
    <MsQuicDir>$(AllegianceRoot)packages\Microsoft.Native.Quic.MsQuic.Schannel.$(MsQuicVersion)\build\native\</MsQuicDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <PreprocessorDefinitions>WIN32;_WINDOWS;STRICT;WINVER=0x0A00;_WIN32_WINNT=0x0A00;DIRECTINPUT_VERSION=0x0800;_HAS_AUTO_PTR_ETC=1;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Same order as the original makefile.inc: project-local dirs (added by
           each project) first, then the shared ones. -->
      <AdditionalIncludeDirectories>$(AllegianceRoot)Inc;$(AllegianceRoot)zlib;$(AllegianceRoot)guids;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- The system libraries the original makeexe.inc linked, minus the ones
           that no longer exist (d3drm, dplayx, icqmapi) and with their modern
           names (dinput8, strmiids, comsuppw). -->
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;winspool.lib;comdlg32.lib;advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;odbc32.lib;odbccp32.lib;d3d11.lib;dxgi.lib;dsound.lib;dxguid.lib;dinput8.lib;winmm.lib;strmiids.lib;comctl32.lib;version.lib;ws2_32.lib;delayimp.lib;wininet.lib;urlmon.lib;lz32.lib;netapi32.lib;comsuppw.lib;oledb.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(AllegianceRoot)Inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <Culture>0x0409</Culture>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <!-- A pointer cast to a 32-bit integer (C4311, C4302) or a 32-bit integer
       cast to a pointer (C4312) loses half the pointer. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <TreatSpecificWarningsAsErrors>4302;4311;4312;%(TreatSpecificWarningsAsErrors)</TreatSpecificWarningsAsErrors>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;OPTIMIZED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
</Project>
